dio — keeps current sentence loaded so resume continues. */\n  async function pauseSpeak() {\n    try {\n      await trace('pause.call', 'expo-audio.pause');\n      await (0, _audiobookPlayer.pausePlayback)();\n    } catch (e) {\n      await trace('pause.call.err', `${e?.message || e}`);\n    }\n  }\n\n  /** Soft resume via expo-audio — continues the current sentence from where it was. */\n  async function resumeSpeak() {\n    try {\n      await trace('resume.call', 'expo-audio.resume');\n      await (0, _audiobookPlayer.resumePlayback)();\n    } catch (e) {\n      await trace('resume.call.err', `${e?.message || e}`);\n    }\n  }\n\n  // =========================================================================\n  // DIAGNOSTICS (used by Settings screen)\n  // =========================================================================\n\n  async function runFullDiagnostics() {\n    const results = [];\n    const push = async (name, ok, detail) => {\n      results.push({\n        name,\n        ok,\n        detail\n      });\n      await trace(`diag.${name}`, `ok=${ok} ${detail}`);\n    };\n    await trace('==DIAGNOSTICS==', 'start');\n    await push('Platform', Platform.default.OS === 'android' || Platform.default.OS === 'ios', `OS=${Platform.default.OS} ver=${Platform.default.Version}`);\n    await push('Device', !!Device.brand, `${Device.brand || '?'} ${Device.modelName || '?'} mem=${Math.round((Device.totalMemory || 0) / (1024 * 1024))}MB`);\n    const native = NativeModules.default.TTSManager;\n    await push('NativeModule', !!native && typeof native.loadVoice === 'function', `TTSManager=${!!native} hasLoad=${typeof native?.loadVoice}`);\n    const voiceId = await getCurrentVoiceId();\n    const isBundled = !!_piperAssets.PIPER_VOICES[voiceId];\n    const dynVoice = isBundled ? null : await (0, _dynamicVoices.getDynamicVoice)(voiceId);\n    await push('CurrentVoice', isBundled || !!dynVoice, `id=${voiceId} kind=${isBundled ? 'bundled' : dynVoice ? 'dynamic' : 'unkn
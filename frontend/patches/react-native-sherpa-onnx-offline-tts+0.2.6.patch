+// Helper (beppe-audiobooks): append a single line to the same piper-trace.log
+// file that the JS layer is writing to, so we can see both JS- and native-side
+// progress interleaved in the diagnostics screen.
+private fun nativeTrace(ctx: Context, step: String, info: String = "") {
+    try {
+        val f = File(ctx.filesDir, "piper-trace.log")
+        val line = "[" + java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", java.util.Locale.US).also {
+            it.timeZone = java.util.TimeZone.getTimeZone("UTC")
+        }.format(java.util.Date()) + "] [native] " + step + (if (info.isNotEmpty()) " :: $info" else "") + "\n"
+        FileWriter(f, true).use { it.write(line) }
+        android.util.Log.d("piper-trace", line.trim())
+    } catch (_: Exception) { /* never let logging crash the JNI thread */ }
+}

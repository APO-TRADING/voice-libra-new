+/**
+ * PATCH (beppe-audiobooks v6): Foreground Service that keeps the TTS engine
+ * alive when the screen turns off and surfaces a MediaSession-styled
+ * notification with Play / Pause controls on the lock-screen. This is what
+ * makes the Piper TTS behave "exactly like the device's default voice":
+ *
+ *   1. The user presses Play → JS calls startService(playbackInfo).
+ *   2. We acquire a PARTIAL_WAKE_LOCK so the CPU keeps decoding even when
+ *      the device dims.
+ *   3. We request AUDIOFOCUS_GAIN (mediaplayer style) so calls / Spotify
+ *      duck or pause us correctly.
+ *   4. We post a MediaStyle notification — tapping its actions emits
+ *      DeviceEventEmitter events back to JS so PlayerContext can run the
+ *      same code path as the on-screen Play/Pause buttons.
+ *   5. When JS calls stopService(), the wake-lock is released, the
+ *      notification dismissed, and audio focus given back.
+ *
+ * The Service IS NOT a singleton; it's started fresh each time a book starts
+ * playing. The TTSManagerModule.kt is what calls startService(...) /
+ * stopService() through Context.
+ */
+class PiperPlaybackService : Service() {
+    companion object {
+        private const val TAG = "PiperPlaybackSvc"
+        const val ACTION_PLAY = "com.sherpaonnxofflinetts.action.PLAY"
+        const val ACTION_PAUSE = "com.sherpaonnxofflinetts.action.PAUSE"
+        const val ACTION_NEXT = "com.sherpaonnxofflinetts.action.NEXT"
+        const val ACTION_PREVIOUS = "com.sherpaonnxofflinetts.action.PREVIOUS"
+        const val ACTION_STOP = "com.sherpaonnxofflinetts.action.STOP"
+
+        const val EXTRA_TITLE = "title"
+        const val EXTRA_AUTHOR = "author"
+        const val EXTRA_COVER_BASE64 = "coverBase64"
+        const val EXTRA_IS_PLAYING = "isPlaying"
+
+        private const val CHANNEL_ID = "piper-playback"
+        private const val CHANNEL_NAME = "Audiobook playback"
+        private const val NOTIFICATION_ID = 1729
+
+        // Static reference so the singleton ReactContext / module instance can
+        // talk to the live service without juggling binders. Cleared in
+        // onDestroy().
+        @Volatile var instance: PiperPlaybackService? = null
+
+        // Static handle to the React context — set by TTSManagerModule.init()
+        // — so the service can push events back to JS.
+        @Volatile var reactContext: ReactApplicationContext? = null
+    }

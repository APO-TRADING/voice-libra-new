+        }.format(java.util.Date())
+        val line = "[$ts] [native] $step" + (if (info.isNotEmpty()) " :: $info" else "") + "\n"
+        FileWriter(f, true).use { it.write(line) }
+        android.util.Log.d("piper-trace", line.trim())
+    } catch (_: Exception) { /* never let logging crash the JNI thread */ }

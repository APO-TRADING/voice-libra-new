+private fun nativeTrace(ctx: Context, step: String, info: String = "") {
+    try {
+        val f = File(ctx.filesDir, "piper-trace.log")
+        val ts = java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", java.util.Locale.US).also {
